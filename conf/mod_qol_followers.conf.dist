#
# Standalone Utility Follower Module Configuration
# Designed for Turtle WoW Custom vMaNGOS (tortoise-wow targeting client 1.18.1.7272)
#

[ModuleConf]

###################################################################################################
# UTILITY FOLLOWERS CONFIGURATION
###################################################################################################
#
#    UtilityFollowers.Enable
#        Description: Master switch to enable or disable the Utility Followers module entirely.
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Enable = 1

###################################################################################################
# INDIVIDUAL FOLLOWER ENABLES
###################################################################################################
#
#    UtilityFollowers.Banker.Enable
#        Description: Enable or disable the player-owned Banker follower.
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Banker.Enable = 1

#
#    UtilityFollowers.Auctioneer.Enable
#        Description: Enable or disable the player-owned Auctioneer follower.
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Auctioneer.Enable = 1

#
#    UtilityFollowers.Trainer.Enable
#        Description: Enable or disable the player-owned Utility Helper (Trainer & Teleporter) follower.
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Trainer.Enable = 1

###################################################################################################
# MOVEMENT CONFIGURATION
###################################################################################################
#
#    UtilityFollowers.FollowDistance
#        Description: The preferred steady-state distance (in yards) between owner and follower.
#        Default:     3.0
#

UtilityFollowers.FollowDistance = 3.0

#
#    UtilityFollowers.StartFollowingDistance
#        Description: Distance (in yards) beyond which the follower resumes moving toward the owner.
#                     Creates a comfortable deadzone so followers do not jitter on in-place turns.
#        Default:     4.0
#

UtilityFollowers.StartFollowingDistance = 4.0

#
#    UtilityFollowers.CatchUpDistance
#        Description: Distance (in yards) beyond which the follower teleports directly to the owner.
#        Default:     30.0
#

UtilityFollowers.CatchUpDistance = 30.0

#
#    UtilityFollowers.FollowUpdateInterval
#        Description: Cadence (in milliseconds) at which follower movement logic and state are evaluated.
#        Default:     300 (0.3 seconds)
#

UtilityFollowers.FollowUpdateInterval = 300

#
#    UtilityFollowers.TeleportWhenStuck
#        Description: Whether to teleport the follower to the owner if it gets stuck or exceeds CatchUpDistance.
#        Default:     1 - Yes
#                     0 - No
#

UtilityFollowers.TeleportWhenStuck = 1

###################################################################################################
# ACTIVE FOLLOWER CAPACITY & POLICY
###################################################################################################
#
#    UtilityFollowers.MaxActive
#        Description: Maximum number of utility followers a player can have active concurrently.
#        Default:     1
#

UtilityFollowers.MaxActive = 1

#
#    UtilityFollowers.MaxActivePolicy
#        Description: Policy when the player attempts to summon another follower while at MaxActive.
#                     "Reject"        - Fail the new summon cleanly with a notification message.
#                     "ReplaceOldest" - Despawn the player's oldest active follower and summon the new one.
#        Default:     "ReplaceOldest"
#

UtilityFollowers.MaxActivePolicy = "ReplaceOldest"

###################################################################################################
# ENVIRONMENT RESTRICTIONS
###################################################################################################
#
#    UtilityFollowers.AllowInWorld
#        Description: Allow followers in standard open world continent maps.
#        Default:     1 - Allowed
#                     0 - Disabled
#

UtilityFollowers.AllowInWorld = 1

#
#    UtilityFollowers.AllowInDungeons
#        Description: Allow followers inside 5-player dungeon instances.
#        Default:     1 - Allowed
#                     0 - Disabled
#

UtilityFollowers.AllowInDungeons = 1

#
#    UtilityFollowers.AllowInRaids
#        Description: Allow followers inside raid instances.
#        Default:     1 - Allowed
#                     0 - Disabled
#

UtilityFollowers.AllowInRaids = 1

#
#    UtilityFollowers.AllowInBattlegrounds
#        Description: Allow followers inside Battleground PvP instances.
#        Default:     0 - Disabled (prevent PvP interference)
#                     1 - Allowed
#

UtilityFollowers.AllowInBattlegrounds = 0

#
#    UtilityFollowers.AllowInArenas
#        Description: Allow followers inside Arena instances.
#        Default:     0 - Disabled
#                     1 - Allowed
#

UtilityFollowers.AllowInArenas = 0

#
#    UtilityFollowers.AutoSpawn
#        Description: Automatically restore active followers on login.
#        Default:     0 - Disabled (players summon their followers on demand via spell or command)
#                     1 - Enabled
#

UtilityFollowers.AutoSpawn = 0

###################################################################################################
# FOLLOWER APPEARANCE & CREATURE TEMPLATES
###################################################################################################
#
#    Dedicated Turtle WoW Custom Creature Template IDs:
#      - Alliance Banker: 70100 (Pack Mule, Display 14546)
#      - Horde Banker:    70103 (Pack Kodo, Display 7933)
#      - Auctioneer:      70101 (Auctioneer Beardo, Display 7993)
#      - Kirin Tor Familiar: 70102 (Trainer & Teleporter, Display 14432)
#

# Banker Appearance
UtilityFollowers.Banker.CreatureEntry.Horde = 70103
UtilityFollowers.Banker.CreatureEntry.Alliance = 70100
UtilityFollowers.Banker.Horde.DisplayId = 7933
UtilityFollowers.Banker.Alliance.DisplayId = 14546
UtilityFollowers.Banker.Scale = 1.0

# Auctioneer Appearance
UtilityFollowers.Auctioneer.CreatureEntry = 70101
UtilityFollowers.Auctioneer.DisplayId = 7993
UtilityFollowers.Auctioneer.Scale = 1.0

# Kirin Tor Familiar (Trainer & Teleporter) Appearance
# Note: In Turtle WoW 1.18.1 client DBC, Kirin Tor Familiar is Display 14432 (Mana Fiend model),
#       matching summon spell 46465 ("Kirin Tor Familiar").
UtilityFollowers.Trainer.CreatureEntry = 70104
UtilityFollowers.Trainer.DisplayId = 14432
UtilityFollowers.Trainer.Scale = 0.5

###################################################################################################
# DEDICATED SUMMON SPELLS CONFIGURATION (NATIVE TURTLE WOW DBC COMPATIBLE)
###################################################################################################
#
#    Characters automatically learn summon spells when reaching the configured level requirement.
#    Casting the spell from the Spellbook or action bar toggles the follower (summon or dismiss).
#
#    Native Turtle WoW Spell IDs (100% compatible with untouched 1.18.1 client DBCs):
#      - Banker Alliance: Spell 46459 ("Forworn Mule" - Pack Mule companion spell)
#      - Banker Horde:    Spell 46483 ("Caravan Kodo" - Pack Kodo companion spell)
#      - Auctioneer:      Spell 46460 ("Mechanical Auctioneer" - Steam-powered auctioneer companion spell)
#      - Utility Helper:  Spell 46465 ("Kirin Tor Familiar" - Radiant Kirin Tor familiar companion spell)
#
#    Followers can also be summoned via chat commands:
#      .utility banker
#      .utility auctioneer
#      .utility helper (or .utility trainer)
#      .utility dismiss
#

#
#    UtilityFollowers.Spells.DefaultLearnLevel
#        Description: Global default character level at which follower spells are automatically learned.
#        Default:     1 (Available right from character creation, or set to 10)
#

UtilityFollowers.Spells.DefaultLearnLevel = 1

# Banker Summon Spells
UtilityFollowers.Banker.Spell.Enable = 1
UtilityFollowers.Banker.Spell.AutoLearn = 1
UtilityFollowers.Banker.Spell.LearnLevel = 1
UtilityFollowers.Banker.Spell.SpellId = 46459
UtilityFollowers.Banker.Spell.SpellId.Alliance = 46459
UtilityFollowers.Banker.Spell.SpellId.Horde = 46483

# Auctioneer Summon Spell
UtilityFollowers.Auctioneer.Spell.Enable = 1
UtilityFollowers.Auctioneer.Spell.AutoLearn = 1
UtilityFollowers.Auctioneer.Spell.LearnLevel = 1
UtilityFollowers.Auctioneer.Spell.SpellId = 46460

# Utility Helper Summon Spell
UtilityFollowers.Trainer.Spell.Enable = 1
UtilityFollowers.Trainer.Spell.AutoLearn = 1
UtilityFollowers.Trainer.Spell.LearnLevel = 1
UtilityFollowers.Trainer.Spell.SpellId = 46465

#
#    UtilityFollowers.Spells.SyncOnLogin
#        Description: Synchronize follower spells on login. Automatically teaches any missing
#                     spells to characters whose level meets the requirement.
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Spells.SyncOnLogin = 1

#
#    UtilityFollowers.Spells.RemoveIfBelowLevel
#        Description: Remove a summon spell if a character de-levels below the required learn level.
#        Default:     0 - Disabled (spells remain known)
#                     1 - Enabled
#

UtilityFollowers.Spells.RemoveIfBelowLevel = 0

#
#    UtilityFollowers.Spells.PreventActionBarAutoAdd
#        Description: Prevent follower spells from automatically taking over action bar slots when learned.
#                     Spells remain readily accessible in the player's Spellbook.
#        Default:     0 - Place on action bar
#                     1 - Spellbook only
#

UtilityFollowers.Spells.PreventActionBarAutoAdd = 0

###################################################################################################
# TRAINER FOLLOWER SERVICE CONFIGURATION
###################################################################################################
#
#    UtilityFollowers.Trainer.FreeTraining
#        Description: Whether class and profession training spells cost 0 copper.
#        Default:     0 - Normal costs apply
#                     1 - Free training
#

UtilityFollowers.Trainer.FreeTraining = 0

#
#    UtilityFollowers.Trainer.IgnoreLevelRequirements
#        Description: Whether to bypass level requirements for trainer spells.
#        Default:     0 - Normal level requirements apply
#                     1 - Bypass level requirements
#

UtilityFollowers.Trainer.IgnoreLevelRequirements = 0

#
#    UtilityFollowers.Trainer.FreeTalentReset
#        Description: Whether resetting talents through Kirin Tor Familiar is free of cost.
#        Default:     0 - Normal progressive reset costs apply
#                     1 - Free talent reset
#

UtilityFollowers.Trainer.FreeTalentReset = 0

#
#    UtilityFollowers.Trainer.ProfessionMode
#        Description: Profession training behavior mode ("Trainer").
#        Default:     "Trainer"
#

UtilityFollowers.Trainer.ProfessionMode = "Trainer"

###################################################################################################
# TRAINER & TELEPORTATION SERVICE CONFIGURATION
###################################################################################################
#
#    UtilityFollowers.Trainer.Teleport.Enable
#        Description: Enable or disable Kirin Tor Familiar's teleportation service to capital cities & hubs.
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Trainer.Teleport.Enable = 1

#
#    UtilityFollowers.Trainer.Teleport.CombatCheck
#        Description: Prevent players from teleporting while in combat.
#        Default:     1 - Enabled (anti-exploit)
#                     0 - Disabled
#

UtilityFollowers.Trainer.Teleport.CombatCheck = 1

#
#    UtilityFollowers.Trainer.Teleport.Cost
#        Description: Copper cost charged per teleportation (e.g. 10000 = 1 gold).
#        Default:     0 - Free
#

UtilityFollowers.Trainer.Teleport.Cost = 0

#
#    UtilityFollowers.Trainer.Teleport.MinLevel
#        Description: Minimum character level required to use teleportation.
#        Default:     1
#

UtilityFollowers.Trainer.Teleport.MinLevel = 1

#
#    UtilityFollowers.Trainer.Teleport.EnableExtraLocations
#        Description: Enable submenu for neutral hubs & quest hubs (Booty Bay, Gadgetzan, Ratchet, Everlook).
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Trainer.Teleport.EnableExtraLocations = 1

#
#    UtilityFollowers.Trainer.Teleport.EnableDungeons
#        Description: Enable submenus for Classic Vanilla 5-player dungeons (Map 0 & 1).
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Trainer.Teleport.EnableDungeons = 1

#
#    UtilityFollowers.Trainer.Teleport.EnableRaids
#        Description: Enable submenus for Classic Vanilla raids (Map 0 & 1: MC, Onyxia, BWL, ZG, AQ20/40, Naxxramas).
#        Default:     1 - Enabled
#                     0 - Disabled
#

UtilityFollowers.Trainer.Teleport.EnableRaids = 1
